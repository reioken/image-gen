# Copy this file to .env and fill in the keys for the providers you use.
# NEVER commit the real .env — it is git-ignored on purpose.
#
# When running the packaged .exe, the real .env lives outside the executable at:
#   Windows: %APPDATA%\ProductImageBatch\.env
# and is created automatically from this template on first launch.

# --- OpenAI GPT Image ---
OPENAI_API_KEY=

# --- Google Gemini / Imagen ---
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Black Forest Labs (FLUX.2 / FLUX.1 Kontext) ---
BFL_API_KEY=

# --- Stability AI ---
STABILITY_API_KEY=

# --- fal.ai ---
FAL_KEY=

# --- Replicate ---
REPLICATE_API_TOKEN=

# --- Ideogram ---
IDEOGRAM_API_KEY=

# --- Recraft ---
RECRAFT_API_TOKEN=

# --- Leonardo.Ai ---
LEONARDO_API_KEY=

# --- Freepik / Magnific (optional, off by default) ---
FREEPIK_API_KEY=
